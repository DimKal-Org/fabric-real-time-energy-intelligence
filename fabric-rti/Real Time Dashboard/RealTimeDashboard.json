  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "00381359-b631-49f7-9bd9-1ccf4f368ef9"
      },
      "text": "ces_energy_readings_curated\n| where Timestamp > ago(10m)\n| summarize AvgCostPerUnit = avg(CostPerUnit) by MachineId\n| order by AvgCostPerUnit desc",
      "id": "2ae4c494-b992-4180-9f05-044f9fc1a5dc",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "00381359-b631-49f7-9bd9-1ccf4f368ef9"
      },
      "text": "ces_energy_readings_curated\n| where Timestamp > ago(15m)\n| summarize AvgPowerKw = avg(PowerKw) by MachineId, bin(Timestamp, 30s)\n| order by Timestamp asc",
      "id": "3a5bdb92-bc99-437c-9626-158a80debd41",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "00381359-b631-49f7-9bd9-1ccf4f368ef9"
      },
      "text": "ces_energy_readings_curated\n| where Timestamp > ago(15m)\n| summarize AvgOee = avg(OeePercent) by MachineId, bin(Timestamp, 1m)",
      "id": "84634708-c7b2-404c-853a-d7bb61f2b944",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "00381359-b631-49f7-9bd9-1ccf4f368ef9"
      },
      "text": "energy_by_shift\n| where ShiftStart > ago(8h)\n| summarize ValueRaw = round(sum(TotalCostEur), 2)\n| extend Label = strcat(\"€ \", tostring(ValueRaw))\n",
      "id": "56a096e5-9701-43e5-9f5b-83e349b14b8c",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "00381359-b631-49f7-9bd9-1ccf4f368ef9"
      },
      "text": "energy_by_shift\n| where ShiftStart > ago(8h)\n| summarize ValueRaw = round(sum(TotalKwh), 2)\n| extend Label = strcat(tostring(ValueRaw),\" kWh\")\n",
      "id": "e115f166-f7fa-4ce9-8126-01499877afcd",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "00381359-b631-49f7-9bd9-1ccf4f368ef9"
      },
      "text": "energy_by_shift\n| where ShiftStart > ago(8h)\n| summarize ValueRaw = round(sum(TotalUnits), 2)\n| extend Label = strcat(tostring(ValueRaw),\"\")\n",
      "id": "1b3bbeb3-5771-425f-b286-f1ec626515f6",
      "usedVariables": []
    }
  ]
